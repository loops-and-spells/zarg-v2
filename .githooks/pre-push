#!/bin/sh
# Every push proves the fast tier end to end; `git push --no-verify` skips it.
# The check writes its evidence to a temp dir, so the push leaves the working tree alone
# (`mise run e2e` writes the evidence you commit).
out=$(mktemp -d)
E2E_EVIDENCE_OUT="$out" mise run -q e2e
status=$?
rm -rf "$out"
exit $status
